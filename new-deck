#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    printf 'Usage: %s NEW_DIRECTORY\n' "$0" >&2
    exit 2
fi

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

mkdir -- "$1"
cp -R -- "$repo_dir/Makefile" "$repo_dir/.gitignore" \
    "$repo_dir/slides.tex" "$repo_dir/handout.tex" \
    "$repo_dir/references.bib" "$repo_dir/data.tex" \
    "$repo_dir/figures" "$repo_dir/template" "$1/"
