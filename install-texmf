#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! texmf_home=$(kpsewhich -var-value=TEXMFHOME) || [ -z "$texmf_home" ]; then
    printf 'Could not find TEXMFHOME. Put TinyTeX or TeX Live on PATH first.\n' >&2
    exit 1
fi

package_dir="$texmf_home/tex/latex/palermo-slides"
mkdir -p -- "$package_dir"
cp -R -- "$repo_dir/template/palermo-slides.sty" "$repo_dir/template/assets" "$package_dir/"

# TinyTeX can share its personal tree with the indexed TEXMFLOCAL tree.
if [ -f "$texmf_home/ls-R" ]; then
    mktexlsr "$texmf_home"
fi

printf 'Installed Palermo Beamer in %s\n' "$package_dir"
